---
import '../styles/global.css';

const startYear = 2026;
const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ignition for macOS — Your next meeting, always in view</title>
    <meta name="description" content="A lightweight macOS menu bar app that shows your next meeting countdown and puts Google Meet and Zoom links one click away." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="hero">

      <!-- App Icon -->
      <div class="app-icon-wrap">
        <div class="app-icon">
          <!--
            Approximation of the SF Symbol "calendar.badge.clock":
            a calendar grid with a clock badge in the bottom-right corner.
          -->
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Calendar body -->
            <rect x="8" y="18" width="64" height="58" rx="10" fill="#1e3a5f" />
            <rect x="8" y="18" width="64" height="58" rx="10" stroke="#3b82f6" stroke-width="2.5" />
            <!-- Calendar header band -->
            <rect x="8" y="18" width="64" height="20" rx="10" fill="#2563eb" />
            <rect x="8" y="28" width="64" height="10" fill="#2563eb" />
            <!-- Binding pegs -->
            <rect x="26" y="10" width="6" height="16" rx="3" fill="#60a5fa" />
            <rect x="48" y="10" width="6" height="16" rx="3" fill="#60a5fa" />
            <!-- Grid dots (calendar days) -->
            <circle cx="24" cy="52" r="3.5" fill="#93c5fd" />
            <circle cx="38" cy="52" r="3.5" fill="#93c5fd" />
            <circle cx="52" cy="52" r="3.5" fill="#ffffff" opacity="0.9" />
            <circle cx="24" cy="66" r="3.5" fill="#93c5fd" />
            <circle cx="38" cy="66" r="3.5" fill="#93c5fd" />
            <!-- Clock badge shadow/cutout -->
            <circle cx="72" cy="72" r="20" fill="#0d1117" />
            <!-- Clock badge face -->
            <circle cx="72" cy="72" r="18" fill="#1e3a5f" />
            <circle cx="72" cy="72" r="18" stroke="#3b82f6" stroke-width="2" />
            <!-- Clock center dot -->
            <circle cx="72" cy="72" r="1.8" fill="#93c5fd" />
            <!-- Hour hand (~10 o'clock) -->
            <line x1="72" y1="72" x2="65" y2="65" stroke="#93c5fd" stroke-width="2.2" stroke-linecap="round" />
            <!-- Minute hand (~12) -->
            <line x1="72" y1="72" x2="72" y2="58" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
            <!-- Cardinal tick marks -->
            <line x1="72" y1="55" x2="72" y2="57.5" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round" />
            <line x1="72" y1="86.5" x2="72" y2="89" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round" />
            <line x1="57" y1="72" x2="59.5" y2="72" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round" />
            <line x1="84.5" y1="72" x2="87" y2="72" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="tagline">
        Your next meeting,<br /><span>always in view</span>
      </h1>

      <p class="sub">
        Ignition for macOS lives quietly in your menu bar, showing a live countdown to your next event and putting every Google Meet and Zoom link one click away.
      </p>

      <!-- Download CTA -->
      <a href="/Ignition.app.zip" download="Ignition.app.zip" class="download-btn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Download for macOS
      </a>
      <p class="platform-note">Requires macOS 13 Ventura or later</p>

      <!-- Feature cards -->
      <div class="features">
        <div class="feature-card">
          <div class="feature-icon">⏱️</div>
          <h3>Live countdown</h3>
          <p>See "5 min", "Now", or "2 hours" at a glance — without opening Calendar.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔗</div>
          <h3>Easily join</h3>
          <p>Google Meet and Zoom links are surfaced front-and-center in the dropdown, ready to tap.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👀</div>
          <h3>Now and later</h3>
          <p>You'll see details for your current meeting and the next — and if you're running late, you'll see "Now" for up to 10 minutes.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📅</div>
          <h3>No login</h3>
          <p>Works with your existing Calendar.app — no account sign-in, no syncing, no setup.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🪶</div>
          <h3>Lightweight &amp; native</h3>
          <p>Pure AppKit, zero background network traffic. It sits in your menu bar and stays out of your way.</p>
        </div>
      </div>

    </main>

    <div class="divider"></div>

    <footer>
      <p>© {copyrightYear} Mike Yavorsky. All rights reserved.</p>
    </footer>
  </body>
</html>
