---
import '../styles/global.css';

const startYear = 2026;
const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ignition for macOS — Your next meeting, always in view</title>
    <meta name="description" content="A lightweight macOS menu bar app that shows your next meeting countdown and puts Google Meet and Zoom links one click away." />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
      /* ── Screenshot Showcase ── */
      .screenshot-showcase {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        margin: 2.5rem 0 3rem;
        width: 100%;
      }

      .screenshot-toggle {
        display: inline-flex;
        background: rgba(0, 0, 0, 0.06);
        border-radius: 10px;
        padding: 3px;
        gap: 2px;
      }

      .toggle-btn {
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.35rem 1.1rem;
        border: none;
        border-radius: 7px;
        cursor: pointer;
        background: transparent;
        color: #eee;
        transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
        letter-spacing: 0.01em;
      }

      .toggle-btn.active {
        background: #fff;
        color: #111;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12), 0 0 0 0.5px rgba(0,0,0,0.06);
      }

      .screenshot-frame {
        position: relative;
        width: min(560px, 92vw);
      }

      .screenshot {
        width: 100%;
        border-radius: 14px;
        box-shadow:
          0 2px 8px rgba(0, 0, 0, 0.08),
          0 12px 40px rgba(0, 0, 0, 0.14);
        display: block;
        opacity: 0;
        transition: opacity 0.28s ease;
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
      }

      .screenshot.active {
        opacity: 1;
        position: relative;
        pointer-events: auto;
      }

      .screenshot-caption {
        font-size: 0.87rem;
        color: #888;
        text-align: center;
        max-width: 380px;
        line-height: 1.55;
        margin: 0;
      }

      .screenshot-caption strong {
        color: #ccc;
      }
    </style>
  </head>
  <body>
    <main class="hero">

      <!-- App Icon -->
      <div class="app-icon-wrap">
        <div class="app-icon">
          <img src="/Ignition-macOS-Default-128x128@1x.png" alt="Ignition app icon" />
        </div>
      </div>

      <!-- Headline -->
      <h1 class="tagline">
        Your next meeting,<br /><span>always in view</span>
      </h1>

      <p class="sub">
        Ignition for macOS lives quietly in your menu bar, showing a live countdown to your next event and putting every Google Meet and Zoom link one click away.
      </p>

      <!-- Download CTA -->
      <a href="/Ignition.app.zip" download="Ignition.app.zip" class="download-btn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Download for macOS
      </a>
      <p class="platform-note">Requires macOS 13 Ventura or later</p>

      <!-- Screenshot showcase with toggle -->
      <div class="screenshot-showcase">
        <div class="screenshot-toggle" role="group" aria-label="Screenshot mode">
          <button class="toggle-btn active" data-mode="countdown" aria-pressed="true">
            Countdown
          </button>
          <button class="toggle-btn" data-mode="now" aria-pressed="false">
            Now
          </button>
        </div>

        <div class="screenshot-frame">
          <img
            id="screenshot-countdown"
            src="/Countdown.png"
            alt="Ignition menu bar showing a 46-minute countdown to the next meeting"
            class="screenshot active"
          />
          <img
            id="screenshot-now"
            src="/Now.png"
            alt="Ignition menu bar showing 'Now' when a meeting is in progress, with current and next meeting details"
            class="screenshot"
          />
        </div>

        <p class="screenshot-caption" id="screenshot-caption">
          Before a meeting, you'll see a live <strong>minute countdown</strong> so you're never caught off guard.
        </p>
      </div>

      <!-- Feature cards -->
      <div class="features">
        <div class="feature-card">
          <div class="feature-icon">⏱️</div>
          <h3>Live countdown</h3>
          <p>See "5 min", "Now", or "2 hours" at a glance — without opening Calendar.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔗</div>
          <h3>Easily join</h3>
          <p>Google Meet and Zoom links are surfaced front-and-center in the dropdown, ready to tap.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👀</div>
          <h3>Now and later</h3>
          <p>You'll see details for your current meeting and the next — and if you're running late, you'll see "Now" for up to 10 minutes.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📅</div>
          <h3>No login</h3>
          <p>Works with your existing Calendar.app — no account sign-in, no syncing, no setup.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🪶</div>
          <h3>Lightweight &amp; native</h3>
          <p>Pure AppKit, zero background network traffic. It sits in your menu bar and stays out of your way.</p>
        </div>
      </div>

    </main>

    <script>
      const captions = {
        countdown: "Before a meeting, you'll see a live <strong>minute countdown</strong> so you're never caught off guard.",
        now: "When you're in a meeting, the bar shows <strong>Now</strong> — and surfaces the join link front and centre.",
      };

      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode;

          document.querySelectorAll('.toggle-btn').forEach(b => {
            b.classList.toggle('active', b === btn);
            b.setAttribute('aria-pressed', String(b === btn));
          });

          document.querySelectorAll('.screenshot').forEach(img => {
            img.classList.toggle('active', img.id === `screenshot-${mode}`);
          });

          document.getElementById('screenshot-caption').innerHTML = captions[mode];
        });
      });
    </script>

    <div class="divider"></div>

    <footer>
      <p>© {copyrightYear} Mike Yavorsky. All rights reserved.</p>
    </footer>
  </body>
</html>
