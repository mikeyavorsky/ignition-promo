---
import '../styles/global.css';

const startYear = 2026;
const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ignition for macOS — Your next meeting, always in view</title>
    <meta name="description" content="A lightweight macOS menu bar app that shows your next meeting countdown and puts Google Meet and Zoom links one click away." />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <main class="hero">

      <!-- App Icon -->
      <div class="app-icon-wrap">
        <div class="app-icon">
          <img src="/Ignition-macOS-Default-128x128@1x.png" alt="Ignition app icon" />
        </div>
      </div>

      <!-- Headline -->
      <h1 class="tagline">
        Your next meeting,<br /><span>always in view</span>
      </h1>

      <p class="sub">
        Ignition for macOS lives quietly in your menu bar, showing a live countdown to your next event and putting every Google Meet and Zoom link one click away.
      </p>

      <!-- Download CTA -->
      <a href="/Ignition.app.zip" download="Ignition.app.zip" class="download-btn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        Download for macOS
      </a>
      <p class="platform-note">Requires macOS 13 Ventura or later</p>

      <!-- Feature cards -->
      <div class="features">
        <div class="feature-card">
          <div class="feature-icon">⏱️</div>
          <h3>Live countdown</h3>
          <p>See "5 min", "Now", or "2 hours" at a glance — without opening Calendar.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔗</div>
          <h3>Easily join</h3>
          <p>Google Meet and Zoom links are surfaced front-and-center in the dropdown, ready to tap.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">👀</div>
          <h3>Now and later</h3>
          <p>You'll see details for your current meeting and the next — and if you're running late, you'll see "Now" for up to 10 minutes.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📅</div>
          <h3>No login</h3>
          <p>Works with your existing Calendar.app — no account sign-in, no syncing, no setup.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🪶</div>
          <h3>Lightweight &amp; native</h3>
          <p>Pure AppKit, zero background network traffic. It sits in your menu bar and stays out of your way.</p>
        </div>
      </div>

    </main>

    <div class="divider"></div>

    <footer>
      <p>© {copyrightYear} Mike Yavorsky. All rights reserved.</p>
    </footer>
  </body>
</html>
